<Window x:Class="EnergyHistoryInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Energy History Inspector" Height="760" Width="1180"
        MinHeight="620" MinWidth="980">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RepairButton" Content="Reparieren" Width="110" Margin="0,0,8,0" Click="RepairButton_Click" IsEnabled="False" />
                <Button Content="Datei oeffnen" Width="120" Click="OpenButton_Click" />
            </StackPanel>
            <TextBlock x:Name="FilePathText" VerticalAlignment="Center" Text="Keine Datei geoeffnet" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Header" Margin="0,0,8,0">
                <UniformGrid Columns="2" Margin="8">
                    <TextBlock Text="Typ" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderTypeText" />
                    <TextBlock Text="Target" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderTargetText" />
                    <TextBlock Text="Seriennummer" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSerialText" />
                    <TextBlock Text="Jahr / Monat" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderPeriodText" />
                    <TextBlock Text="Record-Groesse" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderRecordSizeText" />
                    <TextBlock Text="Header-CRC" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderCrcText" />
                </UniformGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Scan" Margin="8,0,0,0">
                <UniformGrid Columns="2" Margin="8">
                    <TextBlock Text="Dateigroesse" FontWeight="SemiBold" />
                    <TextBlock x:Name="ScanFileSizeText" />
                    <TextBlock Text="Bloecke gueltig / uebersprungen" FontWeight="SemiBold" />
                    <TextBlock x:Name="ScanBlocksText" />
                    <TextBlock Text="Records gueltig / uebersprungen" FontWeight="SemiBold" />
                    <TextBlock x:Name="ScanRecordsText" />
                    <TextBlock Text="Letzter gueltiger Offset" FontWeight="SemiBold" />
                    <TextBlock x:Name="ScanOffsetText" />
                    <TextBlock Text="Letzter Block reparierbar" FontWeight="SemiBold" />
                    <TextBlock x:Name="ScanRepairText" />
                </UniformGrid>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="2" Header="Bloecke" Margin="0,0,0,12">
            <DataGrid x:Name="BlocksGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="BlocksGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Offset" Binding="{Binding Header.Offset}" Width="90" />
                    <DataGridTextColumn Header="Index" Binding="{Binding Header.BlockIndex}" Width="80" />
                    <DataGridTextColumn Header="StartKey" Binding="{Binding Header.StartKey}" Width="90" />
                    <DataGridTextColumn Header="Records" Binding="{Binding Header.RecordCount}" Width="90" />
                    <DataGridTextColumn Header="Payload" Binding="{Binding Header.PayloadSize}" Width="90" />
                    <DataGridCheckBoxColumn Header="Gueltig" Binding="{Binding IsValid}" Width="80" />
                    <DataGridTextColumn Header="Meldung" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Datensaetze">
            <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="60" />
                    <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="140" />
                    <DataGridTextColumn Header="Yield Wh" Binding="{Binding YieldWh}" Width="110" />
                    <DataGridTextColumn Header="Max W" Binding="{Binding MaxPowerW}" Width="90" />
                    <DataGridTextColumn Header="Avg W" Binding="{Binding AvgPowerW}" Width="90" />
                    <DataGridTextColumn Header="Runtime min" Binding="{Binding RuntimeMin}" Width="110" />
                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80" />
                    <DataGridTextColumn Header="Flags" Binding="{Binding Flags}" Width="160" />
                    <DataGridCheckBoxColumn Header="Gueltig" Binding="{Binding IsValid}" Width="80" />
                    <DataGridTextColumn Header="Raw" Binding="{Binding Raw}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <TextBlock Grid.Row="4" x:Name="StatusText" Margin="0,8,0,0" />
    </Grid>
</Window>
